# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=local
DEBUG=0

# ── AWS Configuration ─────────────────────────────────────────────────────────
# For LOCAL DEV: Use LocalStack defaults below
# For PRODUCTION: Change these to real AWS endpoints/credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566    # LOCAL: LocalStack | PROD: remove/change to AWS

# ── LocalStack (Dev Only) ─────────────────────────────────────────────────────
# Get token from https://localstack.cloud (required for LocalStack Pro)
LOCALSTACK_AUTH_TOKEN=

# ── Cognito Configuration ─────────────────────────────────────────────────────
# LocalStack: Populated by localstack-init/00-setup.sh
# Production: Created by Terraform cognito module
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_DOMAIN=

# ── Database Configuration ────────────────────────────────────────────────────
# LOCAL: PostgreSQL instances (run locally or in separate containers)
# PRODUCTION: RDS endpoints
APPOINTMENT_DB_HOST=localhost
APPOINTMENT_DB_PORT=5432
APPOINTMENT_DB_NAME=appointment_db
APPOINTMENT_DB_USER=appointment_user
APPOINTMENT_DB_PASSWORD=appointment_pass

SCHEDULE_DB_HOST=localhost
SCHEDULE_DB_PORT=5432
SCHEDULE_DB_NAME=schedule_db
SCHEDULE_DB_USER=schedule_user
SCHEDULE_DB_PASSWORD=schedule_pass

PAYMENT_DB_HOST=localhost
PAYMENT_DB_PORT=5432
PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=payment_pass

MEDICAL_DB_HOST=localhost
MEDICAL_DB_PORT=5432
MEDICAL_DB_NAME=medical_db
MEDICAL_DB_USER=medical_user
MEDICAL_DB_PASSWORD=medical_pass

# ── DynamoDB Tables (emulated by LocalStack) ──────────────────────────────────
DYNAMODB_NOTIFICATIONS_TABLE=isi-notifications
DYNAMODB_FACILITY_TABLE=isi-facility
DYNAMODB_AUDIT_TABLE=isi-audit-logs

# ── S3 Buckets (emulated by LocalStack) ───────────────────────────────────────
S3_MEDICAL_RECORDS_BUCKET=isi-medical-records
S3_FILE_UPLOAD_BUCKET=isi-files

# ── SQS Queues (emulated by LocalStack) ───────────────────────────────────────
APPOINTMENT_SQS_QUEUE_URL=http://localhost:4566/000000000000/appointment-service-queue
SCHEDULE_SQS_QUEUE_URL=http://localhost:4566/000000000000/schedule-service-queue
PAYMENT_SUCCESS_QUEUE_URL=http://localhost:4566/000000000000/payment-success
PAYMENT_FAILED_QUEUE_URL=http://localhost:4566/000000000000/payment-failed

# ── SNS Topic ARNs ────────────────────────────────────────────────────────────
# Format: arn:aws:sns:region:000000000000:topic-name (LOCAL)
#         arn:aws:sns:region:account-id:topic-name (PROD)
SNS_NOTIFICATION_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:notification-topic

# ── CloudWatch Configuration ──────────────────────────────────────────────────
CLOUDWATCH_AUDIT_LOG_GROUP=/eis/isi-audit-logging

# ── Frontend Configuration ────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8001     # LOCAL: localhost | PROD: API Gateway URL
REACT_APP_COGNITO_REDIRECT_URI=http://localhost:3000  # LOCAL | PROD: frontend domain

# ── PayU Payment Gateway (Sandbox for dev) ────────────────────────────────────
# Get credentials from https://registration.snd.payu.com (sandbox)
PAYU_MERCHANT_ID=
PAYU_API_KEY=
PAYU_OAUTH_CLIENT_ID=
PAYU_OAUTH_CLIENT_SECRET=
