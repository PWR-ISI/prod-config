###############################################################################
# ISI – zapytania HTTP do API (Insomnia / Postman / VS Code "REST Client")
#
# JAK UŻYĆ:
#  - VS Code: zainstaluj rozszerzenie "REST Client", otwórz ten plik, klikaj
#    "Send Request". Uruchom najpierw LOGIN – token podstawi się automatycznie.
#  - Insomnia/Postman: skopiuj METODĘ + URL + nagłówki + body (JSON) do nowego
#    requestu. Token wklej w nagłówek Authorization (z odpowiedzi logowania,
#    pole "id_token"), albo ustaw jako zmienną środowiskową.
#  - Zmienne <...> (np. <facilityId>, <doctorId>, <slotId>) podmień wartościami
#    ze zwróconych odpowiedzi.
###############################################################################

@auth = http://prod-config-auth-alb.elb.localhost.localstack.cloud:4566/api/v2
@fac  = http://prod-config-facility-alb.elb.localhost.localstack.cloud:4566
@sch  = http://prod-config-schedule-alb.elb.localhost.localstack.cloud:4566
@pay  = http://prod-config-payment-alb.elb.localhost.localstack.cloud:4566
@noti = http://prod-config-notification-alb.elb.localhost.localstack.cloud:4566
@med  = http://prod-config-medical-alb.elb.localhost.localstack.cloud:4566
@aud  = http://prod-config-audit-alb.elb.localhost.localstack.cloud:4566
@core = http://prod-config-core-alb.elb.localhost.localstack.cloud:4566

# ── do podmiany po pierwszych odpowiedziach ──────────────────────────────────
@facilityId = 1
@doctorId   = wklej-user_id-lekarza
@slotId     = wklej-slot-id
@apptId     = wklej-appointment-id
@userId     = wklej-user-id

###############################################################################
# 0. LOGOWANIE (uruchom najpierw – w REST Client token podstawia się sam)
###############################################################################

# @name loginAdmin
POST {{auth}}/auth/login/
Content-Type: application/json

{ "email": "admin@isi.test", "password": "Demo1234!" }

###
@adminToken = {{loginAdmin.response.body.$.id_token}}
@adminRefresh = {{loginAdmin.response.body.$.refresh_token}}

# @name loginPatient
POST {{auth}}/auth/login/
Content-Type: application/json

{ "email": "patient@isi.test", "password": "Demo1234!" }

###
@patientToken = {{loginPatient.response.body.$.id_token}}

# @name loginDoctor
# (najpierw zaloz lekarza – sekcja AUTH "admin/staff" + ustaw jego e-mail/haslo)
POST {{auth}}/auth/login/
Content-Type: application/json

{ "email": "lekarz1@isi.test", "password": "DocPass123!" }

###
@doctorToken = {{loginDoctor.response.body.$.id_token}}

###############################################################################
# 1. AUTH-IDENTITY  (token Cognito działa)
###############################################################################

### Rejestracja (rola: patient | doctor | admin)
POST {{auth}}/auth/register/
Content-Type: application/json

{
  "email": "nowy@isi.test",
  "password": "Demo1234!",
  "password_confirm": "Demo1234!",
  "first_name": "Jan",
  "last_name": "Kowalski",
  "role": "patient"
}

### Admin zakłada konto personelu (zwraca user_id = cognito_sub)
POST {{auth}}/admin/staff/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "email": "lekarz1@isi.test",
  "password": "DocPass123!",
  "first_name": "Hanna",
  "last_name": "Nowak",
  "role": "doctor"
}

### Lista użytkowników
GET {{auth}}/users/
Authorization: Bearer {{adminToken}}

### Bieżący użytkownik (z tokenu)   [nieużywane przez frontend]
GET {{auth}}/auth/me/
Authorization: Bearer {{adminToken}}

### Wylogowanie (wpis audytu)        [nieużywane]
POST {{auth}}/auth/logout/
Authorization: Bearer {{adminToken}}

### Odświeżenie tokenu                [nieużywane]
POST {{auth}}/auth/refresh_token/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "refresh": "{{adminRefresh}}" }

### Szczegóły użytkownika             [nieużywane]
GET {{auth}}/users/{{userId}}/
Authorization: Bearer {{adminToken}}

### Edycja użytkownika                [nieużywane]
PATCH {{auth}}/users/{{userId}}/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "phone": "600100200" }

### Usunięcie użytkownika             [nieużywane]
DELETE {{auth}}/users/{{userId}}/
Authorization: Bearer {{adminToken}}

### Profil użytkownika – odczyt       [nieużywane]
GET {{auth}}/users/{{userId}}/profile/
Authorization: Bearer {{adminToken}}

### Profil użytkownika – zapis        [nieużywane]
PUT {{auth}}/users/{{userId}}/profile/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "bio": "Kardiolog z 10-letnim stazem", "specialization": "Kardiolog", "facility": "CM ISI" }

### Audyt (admin widzi wszystkie)     [nieużywane]
GET {{auth}}/audit-logs/
Authorization: Bearer {{adminToken}}

###############################################################################
# 2. FACILITY-STAFF  (token + rola; admin)
###############################################################################

### Lista placówek
GET {{fac}}/api/v2/facilities/
Authorization: Bearer {{adminToken}}

### Wyszukiwanie lekarzy (pacjent) – filtry specialization / facility / q
GET {{fac}}/api/v2/doctors/?specialization=Kardio
Authorization: Bearer {{patientToken}}

### Dodanie profilu lekarza (JSON; user_id z "admin/staff")
POST {{fac}}/api/v2/doctors/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "user_id": "{{doctorId}}",
  "email": "lekarz1@isi.test",
  "first_name": "Hanna",
  "last_name": "Nowak",
  "specialization": "Kardiolog",
  "facility_id": 1,
  "license_number": "PWZ-12345"
}

### Walidacja JSON Schema -> 400 (niepełny payload)
POST {{fac}}/api/v2/doctors/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "first_name": "X" }

### Placówka – utwórz                 [nieużywane]
POST {{fac}}/api/v2/facilities/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "name": "Przychodnia Sloneczna", "address": "ul. Polna 2", "city": "Krakow", "phone": "126000000", "email": "kontakt@ps.pl" }

### Placówka – edytuj                 [nieużywane]
PATCH {{fac}}/api/v2/facilities/{{facilityId}}/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "phone": "999000111" }

### Placówka – usuń                   [nieużywane]
DELETE {{fac}}/api/v2/facilities/{{facilityId}}/
Authorization: Bearer {{adminToken}}

### Lekarz – szczegóły / edycja / usuń  [nieużywane]
GET {{fac}}/api/v2/doctors/1/
Authorization: Bearer {{adminToken}}

###
PATCH {{fac}}/api/v2/doctors/1/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "specialization": "Neurolog" }

###
DELETE {{fac}}/api/v2/doctors/1/
Authorization: Bearer {{adminToken}}

### Legacy staff (model FacilityStaff)  [nieużywane]
GET {{fac}}/api/v2/staff/
Authorization: Bearer {{adminToken}}

###
POST {{fac}}/api/v2/staff/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "facility": 1, "user_id": 123, "role": "nurse", "specialization": "Pediatria", "license_number": "X1" }

###############################################################################
# 3. SCHEDULE  (sloty + wizyty)
###############################################################################

### Wolne sloty lekarza (publiczne)
GET {{sch}}/api/v1/slots?doctor_id={{doctorId}}&from=2026-06-15&to=2026-06-15
Authorization: Bearer {{patientToken}}

### Pacjent rezerwuje wizytę
POST {{sch}}/api/v1/appointments
Authorization: Bearer {{patientToken}}
Content-Type: application/json

{ "slot_id": "{{slotId}}", "notes": "Bol glowy" }

### Lista wizyt – zależna od roli
GET {{sch}}/api/v1/appointments
Authorization: Bearer {{patientToken}}

###
GET {{sch}}/api/v1/appointments
Authorization: Bearer {{doctorToken}}

###
GET {{sch}}/api/v1/appointments
Authorization: Bearer {{adminToken}}

### Anulowanie wizyty
POST {{sch}}/api/v1/appointments/{{apptId}}/cancel
Authorization: Bearer {{patientToken}}

### Tworzenie slotu (rola admin/doctor)   [nieużywane]
POST {{sch}}/api/v1/slots/
Authorization: Bearer {{doctorToken}}
Content-Type: application/json

{ "doctor_id": "{{doctorId}}", "facility_id": "00000000-0000-0000-0000-000000000000", "start_time": "2026-06-20T09:00:00Z", "end_time": "2026-06-20T09:30:00Z" }

### Szczegóły slotu                      [nieużywane]
GET {{sch}}/api/v1/slots/{{slotId}}/
Authorization: Bearer {{patientToken}}

### Grafiki cykliczne lekarza (admin)    [nieużywane]
GET {{sch}}/api/v1/doctor-schedules/?doctor_id={{doctorId}}
Authorization: Bearer {{adminToken}}

###
POST {{sch}}/api/v1/doctor-schedules/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "doctor_id": "{{doctorId}}", "facility_id": "00000000-0000-0000-0000-000000000000", "weekday": 0, "start_time": "09:00", "end_time": "17:00", "slot_duration_minutes": 30, "valid_from": "2026-06-01", "valid_until": "2026-12-31" }

### Dostępność lekarza                   [nieużywane]
GET {{sch}}/api/v1/doctors/{{doctorId}}/availability?from=2026-06-15T00:00:00Z&to=2026-06-16T00:00:00Z
Authorization: Bearer {{patientToken}}

### Szczegóły wizyty                      [nieużywane]
GET {{sch}}/api/v1/appointments/{{apptId}}/
Authorization: Bearer {{patientToken}}

### INTERNAL: rezerwacja slotu (nagłówek X-Internal-Token zamiast tokenu)
POST {{sch}}/api/v1/slots/{{slotId}}/reserve/
X-Internal-Token: dev-internal-token
Content-Type: application/json

{ "appointment_id": "00000000-0000-0000-0000-000000000009" }

### INTERNAL: zwolnienie slotu
POST {{sch}}/api/v1/slots/{{slotId}}/release/
X-Internal-Token: dev-internal-token

###############################################################################
# 4. PAYMENT  (AllowAny – bez tokenu; cały serwis nieużywany przez UI)
###############################################################################

### Health
GET {{pay}}/api/payments/health

### Lista zamówień
GET {{pay}}/api/payments/orders/

### Lista płatności
GET {{pay}}/api/payments/payments/

### Tworzenie zamówienia (woła PayU -> bez PAYU_* zwróci 400)
POST {{pay}}/api/payments/orders/
Content-Type: application/json

{ "appointment_id": "11111111-1111-1111-1111-111111111111", "patient_id": "22222222-2222-2222-2222-222222222222", "amount": "150.00", "currency": "PLN", "description": "Wizyta" }

### Webhook PayU (weryfikuje podpis -> bez creds 401)
POST {{pay}}/api/payments/webhook
Content-Type: application/json

{ "order": { "orderId": "X", "orderStatus": "COMPLETED", "extOrderId": "1" } }

###############################################################################
# 5. NOTIFICATION / MEDICAL / AUDIT  (simplejwt -> token Cognito = 401)
###############################################################################

### Notifications (z tokenem Cognito -> 401)
GET {{noti}}/api/v2/notifications/?recipient_id=1
Authorization: Bearer {{adminToken}}

### Medical records (-> 401)
GET {{med}}/api/v2/records/
Authorization: Bearer {{adminToken}}

### Audit logs (-> 401)
GET {{aud}}/api/v2/logs/
Authorization: Bearer {{adminToken}}

### Health (bez tokenu)
GET {{med}}/api/v2/health/

###
GET {{aud}}/api/v2/health/

###############################################################################
# 6. APPOINTMENT-SERVICE (core) – równoległy system, frontend go nie używa
###############################################################################

### Lista (wg user_id z tokenu)
GET {{core}}/api/v1/appointments
Authorization: Bearer {{patientToken}}

### Tworzenie (pełny payload)
POST {{core}}/api/v1/appointments
Authorization: Bearer {{patientToken}}
Content-Type: application/json

{
  "patient_id": "33333333-3333-3333-3333-333333333333",
  "doctor_id": "{{doctorId}}",
  "slot_id": "44444444-4444-4444-4444-444444444444",
  "facility_id": "00000000-0000-0000-0000-000000000000",
  "scheduled_start": "2026-06-20T09:00:00Z",
  "scheduled_end": "2026-06-20T09:30:00Z",
  "notes": "test core"
}
