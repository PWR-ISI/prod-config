# prod-config .gitignore

# Ignore environment and build artifacts
.env
*.env
!.env.example
*.pyc
__pycache__/
.vscode/
.idea/

# LocalStack persistence + generated IDs
localstack-data/
localstack-init/ids.env

# Claude Code working directory
.claude/

# Build artifacts and deployment
deploy/
*.tar
*.log

# OS files
.DS_Store
Thumbs.db

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
terraform/tfplan
tfplan

# Django (stray test artifacts that land here when manage.py runs from this dir)
db.sqlite3

# Node
node_modules/
dist/

# runtime/scratch dumps
auth-tail.txt
facility-clog.txt
seed-out.txt
