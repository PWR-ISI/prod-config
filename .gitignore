# prod-config .gitignore

# Ignore environment and build artifacts
.env
*.env
*.pyc
__pycache__/
.vscode/
.idea/

# Terraform state, plans, and provider cache
.terraform/
*.tfstate
*.tfstate.*
tfplan
*.tfplan

# Logs and debug scratch files
*.log
auth-tail.txt
facility-clog.txt
seed-out.txt
seed_june.py
